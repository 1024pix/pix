{
  "include": ["**/*.ts"],
  "compilerOptions": {
    "types": ["node", "mocha", "sinon-chai", "chai-as-promised"],
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "noEmit": true
  }
}
