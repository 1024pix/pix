                    "id": "3",
                    "content": "<p>Site officiel colisée</p>",
                    "feedback": {
                      "state": "<p>Bonne réponse !</p>",
                      "diagnosis": "<p>Le site officiel est https://colosseo.it/ et devrait sortir en tête de liste sur la plupart des moteurs de recherche. </p>"
                    }
                  }
                ],
                "solution": "3"
              }
            }
          ]
