                      "licence": ""
                    }
                  ]
                },
                {
                  "elements": [
                    {
                      "id": "3ae25cff-f570-4f63-9b81-05cff2fba4d5",
                      "type": "text",
                      "content": "<p>Voici des photographies de muguet.<br></p>"
                    },
                    {
                      "id": "39681dab-c586-4194-bdf2-fe570b088714",
                      "type": "image",
                      "url": "https://assets.pix.org/draft/modules/ia-def-ind/PlusieursMuguet.png",
