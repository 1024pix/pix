                "feedback": {
                  "state": "<p>Mauvaise réponse</p>",
                  "diagnosis": ""
                }
              },
              {
                "id": "2",
                "content": "<p>C’est un comportement suspect</p>",
                "feedback": {
                  "state": "<p>Bonne réponse</p>",
                  "diagnosis": "<p><br></p>"
                }
              },
              {
                "id": "3",
                "content": "<p>Je ne sais pas</p>",
