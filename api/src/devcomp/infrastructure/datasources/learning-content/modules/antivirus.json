        {
          "type": "element",
          "element": {
            "id": "1e96f2cf-8aca-491d-ade4-da34013305a5",
            "type": "text",
            "content": "<p><strong>Première méthode de détection.</strong></p><p>L'antivirus dispose d'une liste de virus connus, une sorte de bibliothèque. </p><p>Utilisez cette liste pour repérer les programmes malveillants installés sur l'appareil.<br></p>"
          }
        },
        {
          "type": "element",
          "element": {
            "id": "0f75240c-2e18-414e-b4e3-0ffc4f0ff4bb",
            "type": "embed",
            "isCompletionRequired": false,
            "title": "Simulateur recherche virus",
            "url": "https://1024pix.github.io/atelier-contenus/FRI/detection_specifique_1.html",
            "instruction": "<p>Cliquez sur un programme installé, puis sur un virus correspondant.</p>",
            "solution": "nul",
            "height": 600
          }
        }
      ]
    },
    {
      "id": "59e6bf90-78cb-4c2e-8342-4f3e7d651895",
