        {
          "type": "element",
          "element": {
            "id": "84c59511-816a-472a-ab69-5067c227c9db",
            "type": "text",
            "content": "<p>📖 L’antivirus <strong>compare</strong> la liste de vos programmes à une <strong>bibliothèque de virus</strong> <strong>connus</strong>, appelée base de signatures.</p>"
          }
        }
      ]
    },
