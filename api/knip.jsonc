{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "**/scripts/**/*.{js,ts}",
    "**/*job-controller.{js,ts}",
    "datamart/**/*.{js,ts}",
    "datawarehouse/**/*.{js,ts}",
    "db/**/*.{js,ts}",
    "tests/**/*.{cjs,js,ts}",
  ],
  "ignoreDependencies": [
    "json-autotranslate", // used by api/scripts/translate-language-files.js
  ],
  "ignoreFiles": [
    "tracing.worker.maddo.js", // used by Procfile-maddo
  ],
}
