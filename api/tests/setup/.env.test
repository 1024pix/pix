# Log
LOG_ENABLED=false
LOG_STARTING_EVENT_DISPATCH=false
LOG_ENDING_EVENT_DISPATCH=false

# Postgres
DATABASE_URL=postgresql://postgres@localhost/pix_test
JOBS_DATABASE_URL=postgresql://postgres@localhost/pix_test
DATAMART_DATABASE_URL=postgresql://postgres@localhost/datamart_test
DATAWAREHOUSE_DATABASE_URL=postgresql://postgres@localhost/datawarehouse_test

# Redis
REDIS_URL=redis://localhost:6379
REDIS_CACHE_KEY_LOCK_TTL=100
REDIS_CACHE_LOCKED_WAIT_BEFORE_RETRY=1

# Authentication
AUTH_SECRET=the-password-must-be-at-least-32-characters-long
BCRYPT_NUMBER_OF_SALT_ROUNDS=1
PIX_ADMIN_LOGIN_FROM_PASSWORD_ENABLED=false

# Import
IMPORT_STORAGE_ACCESS_KEY_ID=nothing
IMPORT_STORAGE_SECRET_ACCESS_KEY=nothing
IMPORT_STORAGE_REGION=nothing
IMPORT_STORAGE_ENDPOINT=http://localhost:9090
IMPORT_STORAGE_BUCKET_NAME=pix-import-test

# Other
ENGINEERING_USER_ID=99999

# Answers history
ANSWERS_HISTORY_EXPORT_STORAGE_ACCESS_KEY_ID=test
ANSWERS_HISTORY_EXPORT_STORAGE_SECRET_ACCESS_KEY=test
ANSWERS_HISTORY_EXPORT_STORAGE_ENDPOINT=http://localhost:9090
ANSWERS_HISTORY_EXPORT_STORAGE_REGION=pix
ANSWERS_HISTORY_EXPORT_STORAGE_BUCKET_NAME=pix-answers-history-export-test
ANSWERS_HISTORY_ASSESSMENT_ID_RANGE=1000
ANSWERS_HISTORY_ASSESSMENT_ID_BATCH_SIZE=1000
ANSWERS_HISTORY_ANSWER_BATCH_SIZE=1000

# Api data
API_DATA_URL=http://example.net
API_DATA_USERNAME=user
API_DATA_PASSWORD=passowrd
API_DATA_QUERIES={"coverageRateByTubes":"coverage-rate-query-id"}

# Audit Logger
PIX_AUDIT_LOGGER_BASE_URL=http://audit-logger.local
PIX_AUDIT_LOGGER_CLIENT_SECRET=client-super-secret

# Login
LOGIN_TEMPORARY_BLOCKING_THRESHOLD_FAILURE_COUNT=10
LOGIN_TEMPORARY_BLOCKING_BASE_TIME=2m
LOGIN_BLOCKING_LIMIT_FAILURE_COUNT=30
EMAIL_CONNECTION_WARNING_PERIOD=1y

# LCMS
LCMS_API_KEY=test-api-key
LCMS_API_URL=https://lcms-test.pix.fr/api
LCMS_API_OAUTH_BASIC_TOKEN=dGVzdC1wYXNzd29yZA==

# LLM
LLM_CHAT_TEMPORARY_STORAGE_EXP_DELAY_SECONDS=12h
LLM_LOCK_CHAT_EXPIRATION_DELAY_SECONDS=1
LLM_INFERENCE_API_POST_PROMPT_URL=https://llm-test.pix.fr/api/chat
LLM_CONFIGURATION_EDITOR_API_JWT_SECRET="Le secret dans les tests"
LLM_INFERENCE_API_JWT_SECRET="Le secret dans les tests"
LLM_CONFIGURATION_EDITOR_API_GET_CONFIGURATION_URL=https://llm-test.pix.fr/api/configurations

# Domain
TLD_FR=.fr
TLD_ORG=.org
DOMAIN_PIX=https://pix
DOMAIN_PIX_APP=https://test.app.pix
DOMAIN_PIX_ORGA=https://orga.pix
DOMAIN_PIX_CERTIF=https://certif.pix

# Features
DAY_BEFORE_IMPROVING=4
DAY_BEFORE_RETRYING=4
DAY_BEFORE_COMPETENCE_RESET_V2=7
GAR_ACCESS_V2=false
MAX_REACHABLE_LEVEL=5

# Feature toggles
DEPRECATE_PE_PUSH_NOTIFICATION=false
FT_ALWAYS_OK_VALIDATE_NEXT_CHALLENGE_ENDPOINT=false

# Metrics
FT_ENABLE_DIRECT_METRICS=false
FT_OPPSY_DISABLED=false

# LTI
LTI_AUTHORIZED_PLATFORMS='https://moodle.example.net'

# MAILING
MAILING_ENABLED=false
MAILING_PROVIDER=brevo
MAILING_SMTP_URL=smtp://username:password@localhost:1025

# Brevo
BREVO_API_KEY=test-api-key
BREVO_ACCOUNT_CREATION_TEMPLATE_ID=test-account-creation-template-id
BREVO_ACCOUNT_RECOVERY_TEMPLATE_ID=test-account-recovery-template-id
BREVO_CLEA_ACQUIRED_RESULT_TEMPLATE_ID=test-acquired-clea-result-template-id
BREVO_CERTIFICATION_CENTER_INVITATION_TEMPLATE_ID=test-certification-center-invitation-template-id
BREVO_CERTIFICATION_RESULT_TEMPLATE_ID=test-certification-result-template-id
BREVO_CPF_TEMPLATE_ID=test-cpf-email-template-id
BREVO_EMAIL_VERIFICATION_CODE_TEMPLATE_ID=test-email-verification-code-template-id
BREVO_ORGANIZATION_INVITATION_TEMPLATE_ID=test-organization-invitation-demand-template-id
BREVO_ORGANIZATION_INVITATION_SCO_TEMPLATE_ID=test-organization-invitation-sco-demand-template-id
BREVO_PASSWORD_RESET_TEMPLATE_ID=test-password-reset-template-id
BREVO_SELF_ACCOUNT_DELETION_TEMPLATE_ID=test-self-account-deletion-template-id
BREVO_TARGET_PROFILE_NOT_CERTIFIABLE_TEMPLATE_ID=test-target-profile-no-certifiable-template-id
BREVO_WARNING_CONNECTION_TEMPLATE_ID=test-warning-connection-template-id

# HTTP server
BASE_URL=https://api.test.pix.fr
PORT=3000
HTTP_SERVER_RESPONSE_TIMEOUT_MS=10000

# API manager
APIM_URL=http://external-partners-access/

# partner
FETCH_TIMEOUT_MILLISECONDS=10ms

# CPF
CPF_EXPORTS_STORAGE_ACCESS_KEY_ID=cpfExports.accessKeyId
CPF_EXPORTS_STORAGE_SECRET_ACCESS_KEY=cpfExports.secretAccessKey
CPF_EXPORTS_STORAGE_ENDPOINT=http://cpf-exports.fake.endpoint.example.net
CPF_EXPORTS_STORAGE_REGION=eu-west-par
CPF_EXPORTS_STORAGE_BUCKET_NAME=cpfExports.bucket
CPF_EXPORTS_STORAGE_PRE_SIGNED_EXPIRES_IN=3600
CPF_SEND_EMAIL_JOB_RECIPIENT=team-all-star-certif-de-ouf@example.net
CPF_SEND_EMAIL_JOB_CRON="0 3 * * *"

# Data protection policy
DATA_PROTECTION_POLICY_UPDATE_DATE="2022-12-25 00:00:01"

# Attestations
ATTESTATIONS_STORAGE_ACCESS_KEY_ID=attestations.accessKeyId
ATTESTATIONS_STORAGE_SECRET_ACCESS_KEY=attestations.secretAccessKey
ATTESTATIONS_STORAGE_ENDPOINT=http://attestations.fake.endpoint.example.net
ATTESTATIONS_STORAGE_REGION=eu-west-par
ATTESTATIONS_STORAGE_BUCKET_NAME=attestations.bucket

# Modules
REDIRECTION_URL_SECRET=moduleUrlSecret
DEVCOMP_MODULE_JSON_SCHEMA_CACHE_MAX_AGE=123
