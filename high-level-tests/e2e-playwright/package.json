{
  "name": "e2e-playwright",
  "version": "1.222.0",
  "type": "module",
  "private": true,
  "description": "Permet d'exécuter des tests de bout en bout sur la plateforme Pix",
  "homepage": "https://github.com/1024pix/pix#readme",
  "author": "GIP Pix",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/1024pix/pix"
  },
  "engines": {
    "node": "^24.11.1"
  },
  "scripts": {
    "codegen": "playwright codegen",
    "test": "playwright test",
    "test:snapshot": "UPDATE_SNAPSHOTS=true playwright test --grep @snapshot",
    "test:ui": "playwright test --ui",
    "test:prescription": "playwright test --config playwright.config.prescription.ts",
    "test:prescription:ui": "playwright test --config playwright.config.prescription.ts --ui",
    "test:certif": "rm -rf ./.auth/* && playwright test --config playwright.config.certif.ts",
    "test:certif:testref": "rm -rf ./.auth/* && ts-node scripts/recette-certif/run-by-test-ref.ts",
    "test:certif:snapshot": "rm -rf ./.auth/* && UPDATE_SNAPSHOTS=true playwright test --config playwright.config.certif.ts --grep @snapshot",
    "test:certif:snapshot:testref": "rm -rf ./.auth/* && ts-node scripts/recette-certif/run-by-test-ref.ts --snapshot",
    "test:certif:ui": "rm -rf ./.auth/* && playwright test --config playwright.config.certif.ts --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "tsc": "tsc -b"
  },
  "devDependencies": {
    "@1024pix/eslint-plugin": "^2.1.18",
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.50.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "baseline-browser-mapping": "^2.9.14",
    "dotenv": "^17.0.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^17.0.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "ms": "^2.1.3",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.3",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript-eslint": "^8.25.0",
    "zod": "^4.3.6"
  }
}
