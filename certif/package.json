{
  "name": "pix-certif",
  "version": "5.545.0",
  "private": false,
  "description": "Plateforme en ligne de gestion des sessions de certification",
  "license": "AGPL-3.0",
  "author": "GIP Pix",
  "engines": {
    "node": "^24.20.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1024pix/pix.git"
  },
  "ember": {
    "edition": "octane"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf tmp dist node_modules",
    "lint": "run-s -clns 'lint:(hbs|js|scss|translations)'",
    "lint:fix": "run-s -clns 'lint:(hbs|js|scss|translations):fix'",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache --cache-strategy content",
    "lint:js:fix": "npm run lint:js -- --fix",
    "lint:js:uncached": "eslint .",
    "lint:scss": "stylelint 'app/**/*.scss'",
    "lint:scss:fix": "npm run lint:scss -- --fix",
    "lint:translations": "eslint --format node_modules/eslint-plugin-i18n-json/formatter.js translations",
    "lint:translations:fix": "npm run lint:translations -- --fix",
    "dev": "vite",
    "start": "vite",
    "test": "ember exam --path dist --config-file ./testem.cjs",
    "test:ci": "vite build --mode test && ember exam --path dist --config-file ./testem.cjs --split=$CIRCLE_NODE_TOTAL --partition=$((1 + CIRCLE_NODE_INDEX))",
    "test:lint": "npm test && npm run lint"
  },
  "devDependencies": {
    "@1024pix/ember-testing-library": "4.0.1",
    "@1024pix/eslint-plugin": "3.1.1",
    "@1024pix/nebulix-ember": "1.5.0",
    "@1024pix/stylelint-config": "6.0.1",
    "@babel/core": "7.29.13",
    "@babel/eslint-parser": "7.29.13",
    "@babel/plugin-proposal-decorators": "7.29.7",
    "@babel/plugin-transform-runtime": "7.29.7",
    "@ember-intl/v1-compat": "1.3.1",
    "@ember-intl/vite": "2.2.4",
    "@ember/optional-features": "3.0.0",
    "@ember/string": "4.0.1",
    "@ember/test-helpers": "5.8.0",
    "@embroider/compat": "4.1.28",
    "@embroider/config-meta-loader": "1.0.1",
    "@embroider/core": "4.6.10",
    "@embroider/legacy-inspector-support": "0.1.3",
    "@embroider/macros": "1.21.4",
    "@embroider/vite": "1.8.0",
    "@glimmer/component": "2.2.1",
    "@rollup/plugin-babel": "7.1.0",
    "@warp-drive/build-config": "5.9.1",
    "@warp-drive/ember": "5.9.1",
    "@warp-drive/json-api": "5.9.1",
    "@warp-drive/legacy": "5.9.1",
    "@warp-drive/utilities": "5.9.1",
    "babel-plugin-ember-template-compilation": "4.0.1",
    "decorator-transforms": "2.4.0",
    "ember-auto-import": "2.13.1",
    "ember-cli": "7.3.0",
    "ember-cli-babel": "8.3.2",
    "ember-cli-deprecation-workflow": "4.0.1",
    "ember-cli-htmlbars": "7.0.1",
    "ember-cookies": "1.4.1",
    "ember-exam": "10.3.0",
    "ember-intl": "8.4.0",
    "ember-keyboard": "10.0.0",
    "ember-lifeline": "7.1.0",
    "ember-load-initializers": "3.0.1",
    "ember-metrics": "3.0.0",
    "ember-page-title": "9.1.0",
    "ember-qunit": "9.2.0",
    "ember-resolver": "13.2.0",
    "ember-simple-auth": "8.4.1",
    "ember-source": "7.4.0",
    "ember-template-lint": "7.9.4",
    "ember-template-lint-plugin-prettier": "5.0.0",
    "ember-truth-helpers": "5.0.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-chai-expect": "4.1.1",
    "eslint-plugin-ember": "13.9.1",
    "eslint-plugin-i18n-json": "4.0.1",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-qunit": "8.2.6",
    "eslint-plugin-unicorn": "79.0.0",
    "globals": "17.14.0",
    "i18next-browser-languagedetector": "8.3.0",
    "lodash": "4.18.1",
    "miragejs": "0.1.48",
    "p-queue": "10.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-ember-template-tag": "2.1.8",
    "qunit": "3.0.0",
    "qunit-dom": "3.6.0",
    "sass": "1.108.2",
    "sass-embedded": "1.108.2",
    "sinon": "22.1.0",
    "stylelint": "18.0.0",
    "vite": "8.3.8"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12",
    "braces": "3.0.3",
    "eslint": "$eslint",
    "flatted": "3.4.4",
    "handlebars": "4.7.10"
  },
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  }
}
