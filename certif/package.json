{
  "name": "pix-certif",
  "version": "5.314.0",
  "private": false,
  "description": "Plateforme en ligne de gestion des sessions de certification",
  "license": "AGPL-3.0",
  "author": "GIP Pix",
  "engines": {
    "node": "^24.11.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1024pix/pix.git"
  },
  "ember": {
    "edition": "octane"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf tmp dist node_modules",
    "lint": "run-p --continue-on-error 'lint:!(fix)'",
    "lint:fix": "run-p --continue-on-error lint:*:fix",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache --cache-strategy content",
    "lint:js:fix": "npm run lint:js -- --fix",
    "lint:js:uncached": "eslint .",
    "lint:scss": "stylelint app/styles/*.scss app/styles/**/*.scss",
    "lint:scss:fix": "npm run lint:scss -- --fix",
    "lint:translations": "eslint --format node_modules/eslint-plugin-i18n-json/formatter.js translations",
    "lint:translations:fix": "npm run lint:translations -- --fix",
    "preinstall": "npx check-engine",
    "dev": "vite",
    "start": "vite",
    "test": "ember test",
    "test:ci": "npx ember exam --split=$CIRCLE_NODE_TOTAL --partition=$((1 + CIRCLE_NODE_INDEX))",
    "test:lint": "npm test && npm run lint",
    "test:watch": "ember exam --serve --reporter dot",
    "test:ember": "vite build --mode development && ember test --path dist"
  },
  "overrides": {},
  "devDependencies": {
    "@1024pix/ember-api-actions": "^1.1.0",
    "@1024pix/ember-testing-library": "^3.0.27",
    "@1024pix/eslint-plugin": "^2.1.17",
    "@1024pix/pix-ui": "^56.1.0",
    "@1024pix/stylelint-config": "^5.1.37",
    "@babel/core": "^7.25.2",
    "@babel/eslint-parser": "^7.25.9",
    "@babel/plugin-proposal-decorators": "^7.25.9",
    "@babel/plugin-transform-runtime": "^7.26.9",
    "@ember-data/model": "^5.3.9",
    "@ember-intl/v1-compat": "^1.0.2",
    "@ember/optional-features": "^2.2.0",
    "@ember/string": "^4.0.0",
    "@ember/test-helpers": "^5.4.1",
    "@embroider/compat": "^4.0.3",
    "@embroider/config-meta-loader": "^1.0.0",
    "@embroider/core": "^4.0.3",
    "@embroider/macros": "^1.16.10",
    "@embroider/vite": "^1.1.1",
    "@formatjs/intl": "^4.0.0",
    "@glimmer/component": "^1.1.2",
    "@glimmer/tracking": "^1.1.2",
    "@nullvoxpopuli/ember-composable-helpers": "^5.3.0",
    "@rollup/plugin-babel": "^6.0.4",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "dayjs": "^1.11.6",
    "decorator-transforms": "^2.3.0",
    "ember-auto-import": "^2.10.0",
    "ember-cli": "^6.0.0",
    "ember-cli-babel": "^8.2.0",
    "ember-cli-clipboard": "^1.1.0",
    "ember-cli-deprecation-workflow": "^4.0.0",
    "ember-cli-htmlbars": "^7.0.0",
    "ember-cli-matomo-tag-manager": "^1.3.1",
    "ember-cookies": "^1.3.0",
    "ember-data": "^5.3.9",
    "ember-eslint-parser": "^0.5.7",
    "ember-exam": "10.0.1",
    "ember-file-upload": "^9.3.0",
    "ember-intl": "^8.0.3",
    "ember-keyboard": "^9.0.1",
    "ember-lifeline": "^7.0.0",
    "ember-load-initializers": "^3.0.1",
    "ember-metrics": "^2.0.0",
    "ember-mirage": "^0.4.3",
    "ember-modifier": "^4.2.0",
    "ember-page-title": "^9.0.0",
    "ember-qunit": "^9.0.0",
    "ember-resolver": "^13.0.0",
    "ember-simple-auth": "^8.0.0",
    "ember-source": "^6.0.0",
    "ember-template-lint": "^7.0.0",
    "ember-template-lint-plugin-prettier": "^5.0.0",
    "ember-truth-helpers": "^5.0.0",
    "ember-vite-codemod": "^1.4.1",
    "eslint": "^9.26.0",
    "eslint-plugin-chai-expect": "^3.1.0",
    "eslint-plugin-ember": "^12.5.0",
    "eslint-plugin-i18n-json": "^4.0.1",
    "eslint-plugin-import-x": "^4.11.1",
    "eslint-plugin-knex": "v0.2.2",
    "eslint-plugin-mocha": "^11.0.0",
    "eslint-plugin-n": "^17.18.0",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-qunit": "^8.1.2",
    "eslint-plugin-unicorn": "^62.0.0",
    "globals": "^17.0.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "lodash": "^4.17.21",
    "miragejs": "^0.1.48",
    "p-queue": "^8.1.0",
    "postcss": "^8.5.6",
    "postcss-url": "^10.1.3",
    "prettier": "^3.5.3",
    "prettier-plugin-ember-template-tag": "^2.0.5",
    "qunit": "^2.24.1",
    "qunit-dom": "^3.4.0",
    "sass": "^1.89.0",
    "sass-embedded": "^1.97.3",
    "sinon": "^21.0.0",
    "stylelint": "^17.0.0",
    "tracked-built-ins": "^4.0.0",
    "vite": "^6.0.0"
  },
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  }
}
