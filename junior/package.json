{
  "name": "junior",
  "version": "5.523.0",
  "private": false,
  "description": "Version de Pix à destination des élèves du premier degré",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1024pix/pix.git"
  },
  "license": "AGPL-3.0",
  "author": "GIP Pix",
  "engines": {
    "node": "^24.20.0"
  },
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "files": [],
  "scripts": {
    "build": "ember build --environment=production",
    "lint": "run-s -clns 'lint:(hbs|js|scss|translations)'",
    "lint:fix": "run-s -clns 'lint:(hbs|js|scss|translations):fix'",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache --cache-strategy content",
    "lint:js:fix": "npm run lint:js -- --fix",
    "lint:scss": "stylelint app/styles/*.scss 'app/styles/**/*.scss' 'app/**/*.scss'",
    "lint:scss:fix": "npm run lint:scss -- --fix",
    "lint:translations": "eslint --format node_modules/eslint-plugin-i18n-json/formatter.js translations",
    "lint:translations:fix": "npm run lint:translations -- --fix",
    "dev": "ember serve --proxy http://localhost:3000",
    "start": "npm run dev",
    "test": "ember test",
    "test:ci": "npx ember exam --split=$CIRCLE_NODE_TOTAL --partition=$((1 + CIRCLE_NODE_INDEX))",
    "test:lint": "run-p --continue-on-error test lint"
  },
  "devDependencies": {
    "@1024pix/ember-testing-library": "4.0.1",
    "@1024pix/epreuves-components": "4.26.5",
    "@1024pix/eslint-plugin": "3.0.6",
    "@1024pix/nebulix-ember": "1.3.0",
    "@1024pix/stylelint-config": "5.1.37",
    "@babel/eslint-parser": "7.29.9",
    "@babel/plugin-proposal-decorators": "7.29.7",
    "@ember-intl/v1-compat": "1.3.1",
    "@ember/optional-features": "3.0.0",
    "@ember/render-modifiers": "4.0.0",
    "@ember/string": "3.1.1",
    "@ember/test-helpers": "5.7.0",
    "@embroider/compat": "3.9.4",
    "@embroider/core": "3.5.10",
    "@embroider/macros": "1.21.3",
    "@embroider/webpack": "4.1.2",
    "@glimmer/component": "2.1.1",
    "@glimmer/tracking": "1.1.2",
    "@warp-drive/build-config": "5.9.1",
    "@warp-drive/ember": "5.9.1",
    "@warp-drive/json-api": "5.9.1",
    "@warp-drive/legacy": "5.9.1",
    "@warp-drive/utilities": "5.9.1",
    "babel-plugin-ember-template-compilation": "4.0.1",
    "dotenv": "18.0.6",
    "ember-auto-import": "2.13.1",
    "ember-cli": "7.3.0",
    "ember-cli-app-version": "7.0.0",
    "ember-cli-babel": "8.3.2",
    "ember-cli-dependency-checker": "3.3.3",
    "ember-cli-deprecation-workflow": "4.0.1",
    "ember-cli-htmlbars": "7.0.1",
    "ember-cli-inject-live-reload": "2.1.0",
    "ember-cli-mirage": "3.0.4",
    "ember-cli-sass": "11.0.1",
    "ember-exam": "10.2.0",
    "ember-intl": "8.4.0",
    "ember-load-initializers": "3.0.1",
    "ember-modifier": "4.3.0",
    "ember-page-title": "9.0.3",
    "ember-qunit": "9.2.0",
    "ember-resolver": "13.2.0",
    "ember-source": "6.12.0",
    "ember-template-imports": "4.4.0",
    "ember-template-lint": "7.9.4",
    "ember-template-lint-plugin-prettier": "5.0.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-ember": "13.6.1",
    "eslint-plugin-i18n-json": "4.0.1",
    "eslint-plugin-n": "18.4.1",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-qunit": "8.2.6",
    "globals": "17.13.0",
    "loader.js": "4.7.0",
    "lodash": "4.18.1",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.9",
    "prettier-plugin-ember-template-tag": "2.1.8",
    "qunit": "2.26.0",
    "qunit-dom": "3.6.0",
    "sass": "1.105.1",
    "showdown": "2.1.0",
    "sinon": "22.1.0",
    "stylelint": "17.16.0",
    "stylelint-order": "8.1.1",
    "tracked-built-ins": "4.1.2",
    "webpack": "5.111.1",
    "xss": "1.0.15"
  },
  "overrides": {
    "eslint": "$eslint",
    "@xmldom/xmldom": ">=0.9.10",
    "flatted": "3.4.4",
    "braces": "3.0.3"
  },
  "ember": {
    "edition": "octane"
  }
}
