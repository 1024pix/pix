{
  "name": "pix-admin",
  "version": "5.259.0",
  "private": false,
  "description": "Interface d'administration pour les membres de Pix.",
  "license": "AGPL-3.0",
  "author": "GIP Pix",
  "engines": {
    "node": "^22.17.1"
  },
  "ember": {
    "edition": "octane"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1024pix/pix.git"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf tmp dist node_modules",
    "lint": "run-p --continue-on-error 'lint:!(fix)'",
    "lint:fix": "run-p --continue-on-error lint:*:fix",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache --cache-strategy content",
    "lint:js:fix": "npm run lint:js -- --fix",
    "lint:js:uncached": "eslint .",
    "lint:scss": "stylelint app/styles/*.scss 'app/styles/**/*.scss'",
    "lint:scss:fix": "npm run lint:scss -- --fix",
    "lint:translations": "eslint --format node_modules/eslint-plugin-i18n-json/formatter.js translations",
    "lint:translations:fix": "npm run lint:translations -- --fix",
    "preinstall": "npx check-engine",
    "dev": "vite",
    "start": "npm run dev",
    "test": "ember test",
    "test:ci": "vite build --mode test && ember exam --path dist --config-file ./testem.cjs --split=$CIRCLE_NODE_TOTAL --partition=$((1 + CIRCLE_NODE_INDEX))",
    "test:lint": "npm test && npm run lint",
    "test:watch": "ember exam --serve --reporter dot",
    "test:ember": "vite build --mode development && ember test --path dist"
  },
  "devDependencies": {
    "@1024pix/ember-testing-library": "^3.0.25",
    "@1024pix/eslint-plugin": "^2.1.14",
    "@1024pix/pix-ui": "^55.31.1",
    "@1024pix/stylelint-config": "^5.1.37",
    "@babel/eslint-parser": "^7.28.5",
    "@babel/plugin-transform-runtime": "^7.26.9",
    "@ember/optional-features": "^2.2.0",
    "@ember/string": "^4.0.0",
    "@ember/test-helpers": "^5.4.0",
    "@embroider/compat": "^4.0.3",
    "@embroider/config-meta-loader": "^1.0.0",
    "@embroider/core": "^4.0.3",
    "@embroider/legacy-inspector-support": "^0.1.3",
    "@embroider/vite": "^1.1.1",
    "@glimmer/component": "^2.0.0",
    "@glimmer/tracking": "^1.1.2",
    "@rollup/plugin-babel": "^6.0.4",
    "@testing-library/dom": "^10.4.1",
    "babel-plugin-ember-template-compilation": "^2.3.0",
    "decorator-transforms": "^2.3.0",
    "ember-auto-import": "^2.11.1",
    "ember-cli": "~6.8.0",
    "ember-cli-babel": "^8.2.0",
    "ember-cli-clipboard": "^1.3.0",
    "ember-cli-htmlbars": "^6.3.0",
    "ember-cookies": "^1.3.0",
    "ember-cp-validations": "^7.0.0",
    "ember-data": "~5.6.0",
    "ember-eslint-parser": "^0.5.11",
    "ember-exam": "^10.0.0",
    "ember-inflector": "^6.0.0",
    "ember-intl": "^7.4.1",
    "ember-lifeline": "^7.0.0",
    "ember-load-initializers": "^3.0.1",
    "ember-modifier": "^4.2.2",
    "ember-page-title": "^9.0.3",
    "ember-qunit": "^9.0.4",
    "ember-resolver": "^13.1.1",
    "ember-simple-auth": "^8.0.1",
    "ember-source": "~6.8.1",
    "ember-template-lint": "^7.9.3",
    "ember-template-lint-plugin-prettier": "^5.0.0",
    "ember-truth-helpers": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^12.7.4",
    "eslint-plugin-i18n-json": "^4.0.1",
    "eslint-plugin-n": "^17.23.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-qunit": "^8.2.5",
    "globals": "^16.5.0",
    "i18next-browser-languagedetector": "^8.2.0",
    "joi": "^18.0.1",
    "js-base64": "^3.7.8",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.17.21",
    "miragejs": "^0.1.48",
    "npm-run-all2": "^8.0.4",
    "p-queue": "^9.0.0",
    "pako": "^2.1.0",
    "prettier": "^3.6.2",
    "prettier-plugin-ember-template-tag": "^2.1.0",
    "qunit": "^2.24.2",
    "qunit-dom": "^3.5.0",
    "sass-embedded": "^1.93.3",
    "showdown": "^2.1.0",
    "sinon": "^21.0.0",
    "stylelint": "^16.25.0",
    "tracked-built-ins": "^4.0.0",
    "vite": "npm:rolldown-vite@^7.2.5",
    "xss": "^1.0.15"
  },
  "ember-addon": {
    "type": "app",
    "version": 2
  },
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  }
}
